BACKEND_HOST=127.0.0.1
# For a trusted Wi-Fi/LAN receiver, use npm run backend:lan (prints candidate IPv4 URLs).
# Camera clients use http://<laptop-wifi-ip>:3001, never localhost or 0.0.0.0.
BACKEND_PORT=3001
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
# mock: real preprocessing + dummy prediction. model: load the configured Keras checkpoint.
AI_MODE=mock
MODEL_PATH=./models/kaggle-binary/combined_dr_binary_b3_v1/best.keras
MODEL_VERSION=combined-dr-binary-b3-v1-kaggle-v3
MODEL_CLASS_NAMES=No DR,DR
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=15000
MAX_UPLOAD_BYTES=10485760
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/fundus.sqlite
# Leave DATABASE_URL empty to use local SQLite. For MongoDB Atlas, URL-encode credentials.
DATABASE_URL=
DATABASE_NAME=ai_fundus

# Optional Python executable for ReportLab. Defaults to PYTHON or python on PATH.
REPORT_PYTHON=
